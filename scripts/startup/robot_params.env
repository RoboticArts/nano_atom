## Properties
export ROBOT_ID=robot
export ROBOT_USE_SIM=true

# Modules
export ROBOT_RUN_DEVICES=true
export ROBOT_RUN_LOCALIZATION=true
export ROBOT_RUN_NAVIGATION=true

## Initialization
export ROBOT_INITIAL_POSE_X=0.0
export ROBOT_INITIAL_POSE_Y=0.0
export ROBOT_INITIAL_POSE_A=0.0

# Base module
export ROBOT_BASE_XACRO=nano_atom_std.urdf.xacro

export ROBOT_BASE_RUN_RVIZ=true
# Options: base.rviz, robot.rviz
export ROBOT_BASE_RVIZ_FILE=robot.rviz

export ROBOT_BASE_PAD_MODEL=terios
export ROBOT_BASE_PAD_URI=/dev/input/js_robot

export ROBOT_BASE_DRIVER_URI=/dev/ttyS_NANO_ATOM

export ROBOT_BASE_SIM_HEADLESS=false
export ROBOT_BASE_SIM_WORLD="nano_atom_office.world"

# Devices module
export ROBOT_DEVICES_LASER_MODEL=ydlidar_x2
export ROBOT_DEVICES_LASER_ID=front_laser
export ROBOT_DEVICES_LASER_URI=/dev/ttyUSB_LASER
export ROBOT_DEVICES_LASER_MAX_ANGLE=3.14
export ROBOT_DEVICES_LASER_MIN_ANGLE=-3.14

export ROBOT_DEVICES_CAMERA_MODEL=rpi_cam
export ROBOT_DEVICES_CAMERA_ID=front_camera
export ROBOT_DEVICES_CAMERA_URI=0

# Localization module
export ROBOT_LOCALIZATION_RUN_MAPPING=false
export ROBOT_LOCALIZATION_MAP_NAME=demo_map
export ROBOT_LOCALIZATION_LASER_TOPIC=${ROBOT_DEVICES_LASER_ID}/scan

# Navigation module
export ROBOT_NAVIGATION_RUN_MISSION=true