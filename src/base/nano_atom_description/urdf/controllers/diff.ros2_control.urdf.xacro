<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!--Plugin used to connect ROS2 with hardware or simulation -->
  <xacro:macro name="diff_ros2_control" params="robot_id prefix use_sim controller_sim_path hardware_path">

    <xacro:macro name="ros2_joint" params="interface jmin jmax name">
      <joint name="${name}">
        <command_interface name="${interface}">
          <param name="min">${jmin}</param>
          <param name="max">${jmax}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <!-- <state_interface name="effort"/> -->
      </joint>
    </xacro:macro>
      
    <!-- Hardware -->
    <xacro:unless value="$(arg use_sim)">

      <xacro:property name="hw_param" value="${xacro.load_yaml(hardware_path)}"/>

      <ros2_control name="RobotSystem" type="system">
        <!-- Load ROS2 hardware interface-->
        <hardware>
          <plugin>nano_atom_hardware/NanoAtomSystem</plugin>
          <param name="left_wheel_joint">${hw_param['left_wheel_joint']}</param>
          <param name="right_wheel_joint">${hw_param['right_wheel_joint']}</param>
          <param name="port">${hw_param['port']}</param>
        </hardware>

        <xacro:ros2_joint interface="velocity" jmin="-5" jmax="5" name="${prefix}left_wheel_joint"/>
        <xacro:ros2_joint interface="velocity" jmin="-5" jmax="5" name="${prefix}right_wheel_joint"/>

      </ros2_control>

    </xacro:unless>

    <!-- Simulation -->
    <xacro:if value="$(arg use_sim)">

      <!-- Load Gazebo controller_manager -->
      <gazebo>
        <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="gz_ros2_control-system">
          <robot_param>robot_description</robot_param>
          <robot_param_node>robot_state_publisher</robot_param_node>
          <parameters>${controller_sim_path}</parameters>
          <ros>
            <namespace>${robot_id}</namespace>
          </ros>
        </plugin>
      </gazebo>

      <!-- Load gazebo hardware interface-->
      <ros2_control name="GazeboSystem" type="system">
      
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <xacro:ros2_joint interface="velocity" jmin="-5" jmax="5" name="${prefix}left_wheel_joint"/>
        <xacro:ros2_joint interface="velocity" jmin="-5" jmax="5" name="${prefix}right_wheel_joint"/>

      </ros2_control>

    </xacro:if>
    
      
  </xacro:macro>

</robot>