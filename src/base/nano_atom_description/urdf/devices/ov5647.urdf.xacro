<?xml version="1.0"?>
<robot name="sensor_ov5647" xmlns:xacro="http://www.ros.org/wiki/xacro">


<xacro:property name="M_PI" value="3.1415926535897931" />


<!-- - - - - - - - - - - - - - OV5647 SENSOR - - - - - - - - - - - - - -->

  <xacro:macro name="sensor_ov5647" params="prefix prefix_topic:='front_rgbd_camera_' parent use_sim *origin">
    
    <!-- Camera link -->
    <link name="${prefix}link">

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://nano_atom_description/meshes/devices/ov5647.stl" />
        </geometry>
      </visual>

      <collision>
        <origin xyz="-0.005 0 0.00235" rpy="0 0 0"/>
        <geometry>
          <box size="0.0012 0.0252 0.0242"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="1e-5" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
      </inertial>

    </link>

    <!-- Camera joint -->
    <joint name="${prefix}joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/>
      <child link="${prefix}link" />
    </joint>


    <!-- RGB optical link -->
    <link name="${prefix}rgb_optical_link">
    </link>

    <!-- RGB optical joint -->
    <joint name="${prefix}rgb_optical_joint" type="fixed">
      <origin xyz="0.003 0 0" rpy="0 0 0" />
      <parent link="${prefix}link"/>
      <child link="${prefix}rgb_optical_link" />
    </joint>

		<!-- ov5647 sensor for simulation -->
    <xacro:if value="${use_sim}">
      <xacro:sensor_ov5647_gazebo/>
    </xacro:if>

  </xacro:macro>
 

<!-- - - - - - - - - - - - - - OV5647 GAZEBO - - - - - - - - - - - - - -->

  <xacro:macro name="sensor_ov5647_gazebo">
  
    <gazebo reference="${prefix}link">  
      <sensor type="depth" name="${prefix}sensor">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <camera>
          <horizontal_fov>${60.0*M_PI/180.0}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>8.0</far>
          </clip>
        </camera>
        <plugin name="${prefix}controller" filename="libgazebo_ros_camera.so">
          <cameraName>${prefix_topic}</cameraName>
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <imageTopicName>rgb/image_raw</imageTopicName>
          <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>
          <frameName>/${prefix}rgb_optical_link</frameName>
          <hackBaseline>0.07</hackBaseline>
          <distortion_k1>0.0</distortion_k1>
          <distortion_k2>0.0</distortion_k2>
          <distortion_k3>0.0</distortion_k3>
          <distortion_t1>0.0</distortion_t1>
          <distortion_t2>0.0</distortion_t2>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>


  
</robot>