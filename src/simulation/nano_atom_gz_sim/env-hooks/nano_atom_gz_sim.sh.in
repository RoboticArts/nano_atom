#!/bin/sh

PACKAGE_MODELS_DIR="@CMAKE_INSTALL_PREFIX@/share/@PROJECT_NAME@/models"

# PACKAGE_MODELS_DIR="${PACKAGE_MODELS_DIR/#\~/$HOME}"

if [ -z "$GZ_SIM_RESOURCE_PATH" ]; then
    export GZ_SIM_RESOURCE_PATH="$PACKAGE_MODELS_DIR"
else
    case ":$GZ_SIM_RESOURCE_PATH:" in
        *":$PACKAGE_MODELS_DIR:"*) ;;
        *) export GZ_SIM_RESOURCE_PATH="$PACKAGE_MODELS_DIR:$GZ_SIM_RESOURCE_PATH" ;;
    esac
fi